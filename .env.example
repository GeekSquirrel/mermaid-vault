# Frontend Service Configuration
APP_FRONTEND_PORT=80

# API Base URL (Runtime dynamic configuration)
# Mode 1 (Default): Leave empty to use relative path '/api' proxied by frontend Nginx to backend container
API_BASE_URL=
# Mode 2 (Unified Domain): API_BASE_URL=https://example.com/api
# Mode 3 (Standalone Domain): API_BASE_URL=https://api.example.com

# Optional: Backend origin the frontend Nginx proxies '/api/' to.
# Only change when the backend is not the 'backend' service in the same Docker compose network.
# BACKEND_UPSTREAM=backend:8080

# Backend Service Configuration (Internal container settings)
PORT=8080
DB_PATH=/app/data/mermaid.db
NODE_ENV=production

# Optional: Restrict cross-origin API access (comma-separated origin whitelist).
# Only relevant when the frontend calls the API cross-origin (API_BASE_URL Mode 3).
# CORS_ORIGIN=https://example.com

# Optional: Host port mapping for backend debugging (leave empty/commented out by default)
# APP_BACKEND_PORT=8080

# Development only (local pnpm run dev): override the Vite dev-proxy target for '/api'
# MERMAID_API_PROXY_TARGET=http://localhost:8080
