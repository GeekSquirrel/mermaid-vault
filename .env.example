# Environment template for Mermaid Vault.
# Copy to .env for local usage:
#   cp .env.example .env

# ── Production Image & Port (docker-compose.yml) ─────────────────────────────
# Port exposed on host for the unified single-container application
PORT=8080

# Image configuration for production
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=geeksquirrel
# Image tag: `latest` (newest release), a version (e.g. `1.2.3`),
# `main` (newest main-branch build) or a short commit SHA
TAG=latest

# Public Base URL of the unified application (e.g. https://mermaid.example.com or http://localhost:8080)
# Used for MCP view/edit links and client runtime routing. Leave empty for relative same-origin defaults.
BASE_URL=

# ── Development Ports (docker-compose.dev.yml) ────────────────────────────────
# Backend host port for dev hot-reloading container
BACKEND_PORT=8080

# Frontend host port for Vite dev server
FRONTEND_PORT=8081

# Node.js inspector debug port
DEBUG_PORT=9229

