# Frontend Service Configuration
APP_FRONTEND_PORT=80

# API Base URL (Runtime dynamic configuration)
# Mode 1 (Default): Leave empty to use relative path '/api' proxied by frontend Nginx to backend container
API_BASE_URL=
# Mode 2 (Unified Domain): API_BASE_URL=https://example.com/api
# Mode 3 (Standalone Domain): API_BASE_URL=https://api.example.com

# Backend Service Configuration (Internal container settings)
PORT=8080
DB_PATH=/app/data/mermaid.db
NODE_ENV=production

# Optional: Host port mapping for backend debugging (leave empty/commented out by default)
# APP_BACKEND_PORT=8080


