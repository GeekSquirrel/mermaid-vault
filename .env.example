# Environment template for the Docker Compose stacks.
# Contains placeholders only — never commit real values. Copy per environment:
#   cp .env.example .env.dev    # development (used with compose.override.yaml)
#   cp .env.example .env.prod   # production (used with compose.prod.yaml)
#
# Usage:
#   Development: docker compose --env-file .env.dev up
#   Production:  docker compose --env-file .env.prod -f compose.yaml -f compose.prod.yaml up -d
# (.env.dev, .env.prod and compose.prod.yaml are NOT committed to Git.)

# ── Host port mappings ──────────────────────────────────────────────────────
# Frontend host port. Dev stack defaults to 3000, production stack to 80.
APP_FRONTEND_PORT=80
# Backend host port. Only the dev stack exposes the backend (default 8080);
# the production stack keeps it internal to the Docker network.
# APP_BACKEND_PORT=8080

# ── Frontend runtime configuration ──────────────────────────────────────────
# API base URL baked into the frontend at runtime:
#   Mode 1 (Default): leave empty to use relative path '/api', proxied by the
#                     frontend Nginx to the backend container
#   Mode 2 (Unified Domain): API_BASE_URL=https://example.com/api
#   Mode 3 (Standalone Domain): API_BASE_URL=https://api.example.com
API_BASE_URL=
# Optional: backend origin the frontend Nginx proxies '/api/' to.
# Only change when the backend is not the 'backend' service in the same compose network.
# BACKEND_UPSTREAM=http://backend:8080

# ── Backend configuration ───────────────────────────────────────────────────
# Optional: restrict cross-origin API access (comma-separated origin whitelist).
# Only relevant for cross-origin API access (Mode 3).
# CORS_ORIGIN=https://example.com
# Optional: set to false to remove the /api/mcp MCP endpoint for AI agents (see docs/mcp.md).
# MCP_ENABLED=true

# ── Pre-built GHCR images (only used by compose.ghcr.yaml) ──────────────────
# Tag for ghcr.io/geeksquirrel/mermaid-vault-{frontend,backend}:
#   latest (default, release channel) | e.g. 2.1.0 | dev (dev channel)
# MERMAID_IMAGE_TAG=latest

# ── Fixed by the compose files (do not set here) ────────────────────────────
# PORT (8080), DB_PATH (/app/data/mermaid.db) and NODE_ENV (development in the
# dev stack, production in the prod stack) are set by the compose files.

# Development only (local `pnpm dev`, outside Docker): override the Vite dev-proxy target for '/api'
# MERMAID_API_PROXY_TARGET=http://localhost:8080
