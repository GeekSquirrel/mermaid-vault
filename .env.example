# ==============================================================================
# Mermaid Vault - Production Environment Configuration Template (.env.example)
# ==============================================================================
# Usage:
#   cp .env.example .env
#   docker compose up -d
# ==============================================================================

# ── 1. Production Image & Host Port (docker-compose.yml) ──────────────────────
# Registry and namespace for the unified single-container image
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=geeksquirrel
# Image tag: `latest` (newest release), a version (e.g. `2.0.0`), or `main`
TAG=latest

# Host port exposed for the unified single-container application
PORT=8080

# ── 2. Application Core Settings ──────────────────────────────────────────────
# Public Base URL of the unified application (e.g. https://mermaid.example.com or http://localhost:8080)
# Used for MCP view/edit links, OIDC redirect URIs, and client runtime routing.
# Leave empty for relative same-origin defaults.
BASE_URL=

# Comma-separated whitelist of allowed cross-origin origins (leave empty to allow same-origin)
CORS_ORIGIN=

# Enable or disable Model Context Protocol (/api/mcp) endpoint
MCP_ENABLED=true

# ── 3. Optional Diagram Rendering (Chromium / Renderer Container) ─────────────
# WebSocket endpoint for remote Chromium instance (only needed if using 'renderer' service)
# Example: ws://renderer:3000
CHROMIUM_WS_ENDPOINT=

# Rendering timeout in milliseconds (default: 30000 = 30 seconds)
RENDER_TIMEOUT_MS=30000

# ── 4. Authentication & Security ──────────────────────────────────────────────
# Enable local username/password authentication and admin initialization
AUTH_ENABLED=true
# Session expiration in hours (default: 720h = 30 days)
AUTH_SESSION_TTL_HOURS=720
# Optional custom internal token for MCP loopback REST calls
AUTH_INTERNAL_TOKEN=

# ── 5. OIDC Single Sign-On (Authentik, Keycloak, Okta, Authelia, etc.) ─────────
# Enable standard OpenID Connect Single Sign-On
OIDC_AUTH_ENABLED=false
# OpenID Connect Issuer URL (with /.well-known/openid-configuration)
OIDC_ISSUER=
# Client ID registered in your OIDC provider
OIDC_CLIENT_ID=
# Client Secret (leave empty for public PKCE clients)
OIDC_CLIENT_SECRET=
# OIDC Scopes (default: openid profile email)
OIDC_SCOPES=openid profile email
# Explicit redirect URI override (defaults to {BASE_URL}/api/auth/oidc/callback)
OIDC_REDIRECT_URI=
# Optional audience override for JWT validation (defaults to OIDC_CLIENT_ID)
AUTH_JWT_AUDIENCE=
