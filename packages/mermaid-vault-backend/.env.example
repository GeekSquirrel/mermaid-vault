PORT=8080
DB_PATH=./data/mermaid.db
NODE_ENV=production

# Diagram rendering (/api/render). Chromium is auto-detected from common
# install paths; set CHROMIUM_PATH to override.
CHROMIUM_PATH=/usr/bin/chromium-browser
RENDER_TIMEOUT_MS=30000

# MCP (Model Context Protocol) for AI agents. MCP_ENABLED=false removes the
# /api/mcp streamable-HTTP endpoint from the API server. The stdio server
# (pnpm mcp) instead connects to the API via MERMAID_VAULT_URL, and uses
# MERMAID_VAULT_FRONTEND_URL to build view/edit share links.
MCP_ENABLED=true
MERMAID_VAULT_URL=http://127.0.0.1:8080
MERMAID_VAULT_FRONTEND_URL=http://localhost:8081
