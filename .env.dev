# ==============================================================================
# Mermaid Vault - Development Environment Configuration (.env.dev)
# ==============================================================================
# Usage:
#   docker compose -f docker-compose.dev.yml up -d
#   # Or with explicit env-file:
#   docker compose --env-file .env.dev -f docker-compose.dev.yml up -d
# ==============================================================================

# ── 1. Development Ports (docker-compose.dev.yml) ────────────────────────────
# Backend host port for dev hot-reloading container
BACKEND_PORT=8080

# Frontend host port for Vite dev server
FRONTEND_PORT=8081

# Node.js inspector debug port
DEBUG_PORT=9229

# ── 2. Backend Development Settings ──────────────────────────────────────────
NODE_ENV=development
DATABASE_URL=./data/mermaid.db
DB_PATH=./data/mermaid.db

# Public Base URL (leave empty for default relative paths)
BASE_URL=

# CORS origin whitelist (leave empty for same-origin dev proxy)
CORS_ORIGIN=

# Enable MCP endpoint
MCP_ENABLED=true

# Stdio / external MCP client loopback URLs
MERMAID_VAULT_URL=http://127.0.0.1:8080
MERMAID_VAULT_FRONTEND_URL=http://localhost:8081

# ── 3. Frontend Development Settings ─────────────────────────────────────────
# Proxy target for Vite dev server to forward /api requests to backend
MERMAID_API_PROXY_TARGET=http://backend:8080

# ── 4. Diagram Rendering (Development) ───────────────────────────────────────
# Local Chromium path override or remote WebSocket endpoint
CHROMIUM_PATH=
CHROMIUM_WS_ENDPOINT=
RENDER_TIMEOUT_MS=30000

# ── 5. Authentication & Security (Development) ───────────────────────────────
AUTH_ENABLED=true
AUTH_SESSION_TTL_HOURS=720
AUTH_INTERNAL_TOKEN=

# ── 6. OIDC Single Sign-On (Development) ─────────────────────────────────────
OIDC_AUTH_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_REDIRECT_URI=
AUTH_JWT_AUDIENCE=
