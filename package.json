{
  "name": "mermaid-editor-workspace",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm --parallel --filter mermaid-vault-backend --filter mermaid-vault-frontend dev",
    "dev:backend": "pnpm --filter mermaid-vault-backend dev",
    "dev:frontend": "pnpm --filter mermaid-vault-frontend dev",
    "build": "pnpm --recursive build",
    "build:backend": "pnpm --filter mermaid-vault-backend build",
    "build:frontend": "pnpm --filter mermaid-vault-frontend build",
    "test": "pnpm --recursive test",
    "test:backend": "pnpm --filter mermaid-vault-backend test",
    "test:frontend": "pnpm --filter mermaid-vault-frontend test"
  },
  "overrides": {
    "svelte": "5.56.4",
    "bits-ui": "2.18.1",
    "@sveltejs/kit": "2.63.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "vite": "8.0.16",
    "@typescript-eslint/types": "8.60.1"
  }
}




