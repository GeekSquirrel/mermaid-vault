{
  "name": "mermaid-editor-workspace",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "dev:logs": "docker compose -f docker-compose.yml -f docker-compose.dev.yml logs -f",
    "dev:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "dev:reset": "pnpm run dev:down && pnpm run migrate && pnpm run dev",
    "migrate": "docker compose -f docker-compose.yml -f docker-compose.dev.yml run --rm --profile tools migrate",
    "test": "docker compose -f docker-compose.yml -f docker-compose.test.yml run --build --rm app-test",
    "build:image": "docker build --target production -t mermaid-vault:local .",
    "build:test": "docker build --target backend-builder -t mermaid-vault-test:local .",
    "clean": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down -v",
    "clean:dev:port": "node scripts/clean-dev-ports.js",
    "shell": "docker compose -f docker-compose.yml -f docker-compose.dev.yml exec backend /bin/sh"
  },
  "overrides": {
    "svelte": "5.56.4",
    "bits-ui": "2.18.1",
    "@sveltejs/kit": "2.63.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "vite": "8.0.16",
    "@typescript-eslint/types": "8.60.1"
  }
}




